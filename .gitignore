# Generated by Cargo
/target/
**/*.rs.bk

# If you have a binary crate and you want to ignore the output
/*.exe
/*.exe~
/*.dll
/*.so
/*.dylib
/*.log

# Mac
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# By-products of rustc
*.rlib

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo

# Backup files
*~
*.bak

# Rust/Cargo specific
Cargo.lock      # If you're making a library crate, consider including this!
.cargo/

# Optional: coverage, fuzzing, benchmarking
/fuzz/target/
/coverage/
/*.profraw
